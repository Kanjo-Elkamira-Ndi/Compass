# Compass Advisor — Environment Variables
# Copy to .env and fill in values before running locally.

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/compass_ai
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (≥256-bit for HS256) ────────────────────────────────────
JWT_SECRET=dev-only-change-in-production-minimum-256-bits-required-for-hs256-algorithm

# ── Transcript authenticity (≥256-bit for HMAC-SHA256) ───────────
TRANSCRIPT_SIGNING_SECRET=dev-only-transcript-signing-secret-256-bits-minimum

# ── AI Providers ─────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Actually used by the "openai" provider block — it's pointed at Groq's
# OpenAI-compatible endpoint (see application.yml). Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=

# Web search fallback for chat questions the internal RAG documents don't
# cover (see WebSearchService). Optional — the app runs fine without it, it
# just falls back to a generic "I don't have that information" answer
# instead of a web-sourced one. Free tier available at https://tavily.com
TAVILY_API_KEY=

# ── Frontend (Vite) ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
